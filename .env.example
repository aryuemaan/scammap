# Postgres connection string. Local: matches docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scammap

# Set to true for hosted Postgres that requires TLS (Supabase, Neon). Render internal URLs do not need it.
DB_SSL=false

# Port the server listens on. Render sets PORT automatically.
PORT=8080

# Secret used to HMAC reporter_id and ip_prefix before storage. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PEPPER=change-me-to-a-long-random-string

# Licence enforcement. Keep true everywhere except local development.
LICENSE_ENFORCE=true

# Optional bootstrap licence (the whole licence JSON on one line). Loaded only if the database has no licence yet,
# so a fresh deploy is never locked out.
LICENSE_JSON=

# The judges' test tool sends ip_prefix in the report body. Keep true for judging.
# Set false in a real deployment so ip_prefix is always derived from the connection instead.
TRUST_BODY_IP_PREFIX=true

# ---- Gemini (optional). Without a key the app still works: message checks use the built-in rules only. ----
# Get a free key at https://aistudio.google.com/apikey . The key stays on the server; the browser never sees it.
# Only redacted text is sent: phone numbers, UPI IDs, email names and link query strings are replaced first.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- Map tiles (build time, read by Vite: run `npm run build` again after changing these) ----
# Optional MapTiler key for the Live map (MapTiler Dark) and an extra MapTiler Streets style.
# Free key: https://cloud.maptiler.com/account/keys/ . It is visible in the browser (all map keys are), so in MapTiler
# Cloud restrict it to your addresses (http://localhost:8080 and your https://...onrender.com URL).
# Without it the Live map uses CARTO Dark Matter, which needs no key.
VITE_MAPTILER_KEY=

# Default: OpenStreetMap's public tiles with the required attribution. For heavy traffic use your own tile server
# or a provider that allows it, e.g. VITE_TILE_URL=https://{s}.tile.example.com/{z}/{x}/{y}.png
# VITE_TILE_URL=

# Website on Vercel (or any proxy) with the server elsewhere: the server's address, so the Live stream connects to it
# directly. Set it in the Vercel project's Environment Variables, not here. See README "Website on Vercel".
# VITE_LIVE_ORIGIN=https://scammap.onrender.com

# ---- Telegram bot (optional). Create a bot with @BotFather and paste its token. Long polling: works on a laptop. ----
# People can forward a message to get a verdict, check a number, report in a few taps, and send /alerts for area alerts.
TELEGRAM_BOT_TOKEN=
# Optional: a group or channel id that receives every area alert (connector "area-alerts-telegram").
# Send /chatid to the bot in a DM (or /chatid@YourBotName in a group, or /chatid in a channel where it is admin).
# It replies with the id to paste here.
TELEGRAM_ALERT_CHAT_ID=

# ---- Integrations without code: config/connectors.yaml (reloads by itself). Each one turns on when its values are set. ----
# .env is read at start-up: restart after editing. Check: npm run integrations   Test: Help > Integrations > Send test
# Step by step for each: README.md, "Integrations setup".
# Slack incoming webhook for alerts and blocked attacks (api.slack.com/apps > Incoming Webhooks).
SLACK_WEBHOOK_URL=
# A partner's own endpoint for reports and alerts. Bodies are signed: header x-scammap-signature: sha256=<hmac>.
# Demo: npm run webhook-receiver  ->  BANK_WEBHOOK_URL=http://localhost:9900/scammap   Secret: npm run integrations -- secret
BANK_WEBHOOK_URL=
BANK_WEBHOOK_SECRET=
# Email alerts. Gmail: 2-Step Verification on, app password from myaccount.google.com/apppasswords (no spaces), "@" as %40:
# SMTP_URL=smtps://you%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465   ALERT_EMAIL_FROM=ScamMap Alerts <you@gmail.com>
SMTP_URL=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# A JSON list of known scam identifiers to show as "Also listed by" ([{ "type": "phone", "value": "...", "label": "..." }]).
# Demo: npm run integrations -- serve-advisory  ->  ADVISORY_FEED_URL=http://localhost:9901/advisory.json (or a Gist Raw URL)
ADVISORY_FEED_URL=
# Use another connectors file.
# CONNECTORS_FILE=config/connectors.yaml
# Production only: POST /connectors/test (the Send test button) needs this value in header x-connector-test-token.
# CONNECTOR_TEST_TOKEN=

# ---- Web push (area alerts on phones). Leave empty: keys are generated once and stored in the database. ----
# To set your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Live link check. Keep false: the sandbox refuses private and local addresses (SSRF protection). ----
# Only for local testing against a test site on your own machine.
LINKSCAN_ALLOW_PRIVATE=false

# ---- Time-travel defence (on by default, nothing to set) ----
# The server keeps the latest time it has ever seen (system_metadata, raised every 2 s, never lowered). A clock more
# than this many seconds behind it locks the API until the clock is right again.
CLOCK_TOLERANCE_SECONDS=120
# Optional independent time witness: an HTTPS site whose Date header you trust. Catches a clock that was set back
# before the server was ever started. Leave empty to rely on this server's own history and the database clock.
CLOCK_WITNESS_URL=
# DEMO ONLY: lets `npm run demo -- clock` move this server's clock back without touching Windows. Ignored when
# NODE_ENV=production. Never set it on the judged server.
DEMO_TIME_TRAVEL=false

# ---- Local AI (Ollama) for notes in Hindi / Hinglish ----
# Install Ollama (https://ollama.com/download), then:  ollama pull llama3.2:3b
# When a report's scam_type is blank, keyword rules pick a type at once and the local model refines it in the
# background. Notes go only to the model on THIS computer and are never stored or logged.
LOCAL_AI=on
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60
# CPU threads the model may use (default: half your cores), so lookups stay fast while a note is being read.
# OLLAMA_THREADS=4
# Only localhost / private-network Ollama addresses are accepted unless this is true.
OLLAMA_ALLOW_REMOTE=false
# Blank scam_type: fill it from the note (true), or keep "other" (false).
AUTO_SCAM_TYPE=true

# ---- Anti-spoofing ----
# Accounts in one /16 block that use 3+ different /24 prefixes, each report within this many minutes of the last,
# count as one person. 10 catches slower rotation; 5 is the default.
SUBNET_WINDOW_MINUTES=5
# SUBNET_CLUSTERING=false switches this rule off.
SUBNET_CLUSTERING=true

# ---- Map layer B: global threat feed (URLhaus by abuse.ch) ----
# Free Auth-Key: https://auth.abuse.ch/ (sign in, then generate an Auth-Key). The server fetches recent malicious URLs
# every 5 minutes (abuse.ch's limit) and the map shows them as a separate layer. The key never reaches the browser.
URLHAUS_AUTH_KEY=
THREAT_FEED=on
# How many recent URLs per fetch (10-1000) and minutes between fetches (5 or more).
THREAT_FEED_LIMIT=200
THREAT_FEED_MINUTES=5
# Place .com/.xyz/... URLs by the address their domain resolves to (a DNS lookup only; the site is never opened).
THREAT_FEED_DNS=true

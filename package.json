{
  "name": "scammap",
  "version": "1.0.0",
  "description": "Community Scam Map: report and look up scam phone numbers, UPI IDs, links and SMS senders. Anonymous reporters, trust rules against fake reports, signed licence.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node dist/server/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "vitest run",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "sign-licence": "tsx scripts/sign-licence.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "simulate": "tsx scripts/simulate.ts",
    "bench-trust": "tsx scripts/bench-trust.ts",
    "import-data": "tsx scripts/import-data.ts",
    "live-demo": "tsx scripts/live-demo.ts",
    "partner": "tsx scripts/partner.ts",
    "load-test": "tsx scripts/load-test.ts",
    "translate": "tsx scripts/translate.ts",
    "demo": "tsx scripts/demo.ts",
    "clock": "tsx scripts/clock.ts",
    "threats": "tsx scripts/threats.ts",
    "integrations": "tsx scripts/integrations.ts",
    "webhook-receiver": "tsx scripts/webhook-receiver.ts",
    "vercel-config": "tsx scripts/vercel-config.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:copy": "tsx scripts/db-copy.ts",
    "supabase:host": "tsx scripts/supabase-host.ts",
    "check-all": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "fastify": "^5.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.0",
    "react-leaflet": "^4.2.1",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.0",
    "d3-force": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}

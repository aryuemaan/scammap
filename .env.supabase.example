# Run THIS computer's ScamMap against your Supabase database:  cp .env.supabase.example .env  and fill in the values.
# On Render the same keys go in the service's Environment tab (render.yaml asks for DATABASE_URL), never in a file.
# Never commit .env: it holds secrets (.gitignore already excludes it).

# Supabase > your project > Connect > Session pooler (IPv4, port 5432). User is postgres.<project-ref>.
# Find the host for your project with:  PW=<password> npm run supabase:host -- <project-ref>
# URL-encode @ : / # % in the password (node -e "console.log(encodeURIComponent(process.argv[1]))" '<password>').
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# TLS is always on for Supabase; this line just makes it explicit.
DB_SSL=true

# A long random secret. Make one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the SAME value everywhere that writes to this database (your laptop and Render), or a person who reports from
# both counts as two people.
PEPPER=

LICENSE_ENFORCE=true
# true for judging (the test tool sends ip_prefix); false for real use
TRUST_BODY_IP_PREFIX=true

# Optional extras (each switches itself on when set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
URLHAUS_AUTH_KEY=
# Build time (npm run build): a MapTiler key from cloud.maptiler.com (not a Google AIza... key)
VITE_MAPTILER_KEY=
# The local AI only works where Ollama runs (your laptop); Render has none.
LOCAL_AI=on
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# A bot token can be used by ONE running server at a time: put it either here or on Render, not both.
TELEGRAM_BOT_TOKEN=
# Demo only, never on the judged server.
DEMO_TIME_TRAVEL=false
